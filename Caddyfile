{
	# FrankenPHP + Caddy configuration for Laravel
	frankenphp
	order php_server before file_server
}

# HTTP — Coolify akan handle HTTPS termination via reverse proxy
:80 {
	root * /app/public

	# Compress responses
	encode zstd br gzip

	# Classic mode: Laravel must boot per request unless state is reset (Octane)
	php_server

	# Security headers (backup — Laravel middleware juga mengirim ini)
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		-Server
	}
}

